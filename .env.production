# QPDF production build configuration (non-secret; committed on purpose).
# Every processing engine is self-hosted on the site's own origin by
# scripts/qpdf/postbuild.mjs. No third-party CDN is used at runtime.

SITE_URL=https://qpdf.ca

# OCR (Tesseract.js) — worker, cores and language data copied to /wasm/tesseract/
VITE_TESSERACT_WORKER_URL=/wasm/tesseract/worker.min.js
VITE_TESSERACT_CORE_URL=/wasm/tesseract/core
VITE_TESSERACT_LANG_URL=/wasm/tesseract/lang
VITE_TESSERACT_AVAILABLE_LANGUAGES=eng,fra
VITE_OCR_FONT_BASE_URL=/vendor/ocr-fonts

# Fallback fonts used by the PDF editor when adding text
VITE_EMBEDPDF_FONTS_URL=/vendor/embedpdf

# LibreOffice (Word/Excel/PowerPoint/ODF → PDF). Its two engine files exceed
# Cloudflare Pages' 25 MiB per-file limit and must be served from a separate
# static host (Cloudflare R2). Leave empty to build without those tools; set it
# in the Cloudflare Pages environment once the bucket exists (docs/cloudflare-r2.md):
# VITE_LIBREOFFICE_ASSET_URL=https://assets.qpdf.ca/libreoffice/bentopdf-2.8.11/
